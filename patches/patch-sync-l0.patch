+        public void DotnetSetupRejectsUnverifiedArchives(string workflow)
+        {
+            string temp = Path.Combine(Path.GetTempPath(), $"riscv-dotnet-{Guid.NewGuid():N}");
+            string tools = Path.Combine(temp, "bin");
+            string githubEnv = Path.Combine(temp, "github-env");
+            string githubPath = Path.Combine(temp, "github-path");
+            Directory.CreateDirectory(tools);
+
+            try
+            {
+                string curl = Path.Combine(tools, "curl");
+                File.WriteAllText(curl, "#!/bin/sh\nwhile [ \"$#\" -gt 0 ]; do\n  if [ \"$1\" = -o ]; then shift; printf corrupt > \"$1\"; exit 0; fi\n  shift\ndone\nexit 1\n");
+                if (!OperatingSystem.IsWindows())
+                {
+                    File.SetUnixFileMode(curl, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+                }
+
+                string script = GetWorkflowBlock(workflow, "riscv64-dotnet-setup");
+                var result = RunShell(script, Array.Empty<string>(), startInfo =>
