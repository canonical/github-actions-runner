+            Directory.CreateDirectory(temp);
+            File.WriteAllText(Path.Combine(temp, "input"), contents);
+            File.WriteAllText(Path.Combine(temp, "test.patch"), "diff --git a/input b/input\n--- a/input\n+++ b/input\n@@ -1 +1 @@\n-before\n+after\n");
+            return temp;
+        }
+
+        private static (int ExitCode, string Output, string Error) ApplyTestPatch(string temp, string enabled)
+        {
+            string script = GetWorkflowBlock("build.yml", "workflow-test-patch");
+            return RunShell($"{script}\napply_workflow_test_patch \"$@\"", new[] { enabled, "test.patch" }, startInfo =>
+            {
+                startInfo.WorkingDirectory = temp;
+            });
+        }
+
+        private static string GetWorkflowBlock(string workflow, string marker)
+        {
+            string path = Path.GetFullPath(Path.Combine(TestUtil.GetSrcPath(), "..", ".github", "workflows", workflow));
+            string[] lines = File.ReadAllLines(path);
+            int start = Array.FindIndex(lines, line => line.Trim() == $"# {marker}:start");
+            int end = Array.FindIndex(lines, line => line.Trim() == $"# {marker}:end");
+            Assert.True(start >= 0 && end > start, $"Missing {marker} block in {workflow}");
+
+            var script = new System.Text.StringBuilder();
+            for (int i = start + 1; i < end; i++)
+            {
+                script.AppendLine(lines[i].TrimStart());
+            }
+
+            return script.ToString();
+        }
+
+        private static (int ExitCode, string Output, string Error) RunShell(
+            string script,
+            string[] arguments,
+            Action<System.Diagnostics.ProcessStartInfo> configure = null)
+        {
+            var startInfo = new System.Diagnostics.ProcessStartInfo("bash")
+            {
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+                UseShellExecute = false,
+            };
+            startInfo.ArgumentList.Add("-c");
+            startInfo.ArgumentList.Add($"set -euo pipefail\n{script}");
+            startInfo.ArgumentList.Add("workflow-test");
+            foreach (string argument in arguments)
+            {
+                startInfo.ArgumentList.Add(argument);
+            }
+
+            configure?.Invoke(startInfo);
+            using var process = System.Diagnostics.Process.Start(startInfo);
+            string output = process.StandardOutput.ReadToEnd().TrimEnd('\r', '\n');
+            string error = process.StandardError.ReadToEnd();
+            process.WaitForExit();
+            return (process.ExitCode, output, error);
+        }
