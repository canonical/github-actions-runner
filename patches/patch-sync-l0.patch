+                    startInfo.Environment["PATH"] = $"{tools}:{Environment.GetEnvironmentVariable("PATH")}";
+                    startInfo.Environment["RUNNER_TEMP"] = temp;
+                    startInfo.Environment["GITHUB_ENV"] = githubEnv;
+                    startInfo.Environment["GITHUB_PATH"] = githubPath;
